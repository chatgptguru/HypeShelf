# Copy to .env.local and fill in real values. Do not commit .env.local.

# Clerk — from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Convex — written by `npx convex dev` (or set manually for local/cloud URL)
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud

# Convex auth: set in Convex Dashboard → Settings → Environment Variables
# (not in .env.local): CLERK_JWT_ISSUER_DOMAIN = your Clerk Issuer URL
# e.g. https://your-app.clerk.accounts.dev
